          "source": {
            "hosts": ["open.spotify.com"],
            "path": [
              { "type": "literal", "value": "playlist" },
              { "type": "capture", "name": "id", "characterSet": "asciiAlphanumeric", "maxLength": 64 }
            ],
            "query": []
          },
          "target": {
            "scheme": "spotify",
            "host": "playlist",
            "path": [{ "type": "capture", "name": "id" }],
            "query": []
          }
        },
        {
          "id": "show",
          "source": {
            "hosts": ["open.spotify.com"],
            "path": [
              { "type": "literal", "value": "show" },
              { "type": "capture", "name": "id", "characterSet": "asciiAlphanumeric", "maxLength": 64 }
