{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chowser Rust",
  "version": "0.1.0",
  "identifier": "in.sreerams.chowser-test",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "url": "index.html?view=settings",
        "title": "Chowser Rust Settings",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/icon.png"
    ]
  }
}
