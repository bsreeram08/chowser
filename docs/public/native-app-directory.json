    {
      "id": "slack",
      "name": "Slack",
      "summary": "Open Slack workspace channel links in the installed Slack app.",
      "bundleIdentifiers": ["com.tinyspeck.slackmacgap"],
      "nativeSchemes": ["slack"],
      "rules": [
        {
          "id": "channel",
          "source": {
            "hosts": ["app.slack.com"],
            "path": [
              { "type": "literal", "value": "client" },
              { "type": "capture", "name": "team", "characterSet": "asciiAlphanumeric", "maxLength": 32 },
              { "type": "capture", "name": "channel", "characterSet": "asciiAlphanumeric", "maxLength": 32 }
            ],
            "query": []
          },
          "target": {
            "scheme": "slack",
            "host": "channel",
            "path": [],
            "query": [
              { "name": "team", "value": { "type": "capture", "name": "team" } },
              { "name": "id", "value": { "type": "capture", "name": "channel" } }
            ]
          }
        }
      ]
    },
    {
      "id": "zoom",
      "name": "Zoom",
      "summary": "Open Zoom meeting links in the installed Zoom Workplace app.",
      "bundleIdentifiers": ["us.zoom.xos"],
      "nativeSchemes": ["zoommtg"],
      "rules": [
        {
          "id": "join-with-password",
          "source": {
            "hosts": ["zoom.us", "us02web.zoom.us", "us04web.zoom.us", "us05web.zoom.us", "us06web.zoom.us", "us.web.zoom.us"],
            "path": [
              { "type": "literal", "value": "j" },
              { "type": "capture", "name": "meeting", "characterSet": "digits", "maxLength": 16 }
            ],
            "query": [
              {
                "queryName": "pwd",
                "capture": { "name": "password", "characterSet": "urlUnreserved", "maxLength": 128 },
                "required": true
              }
            ]
          },
          "target": {
            "scheme": "zoommtg",
            "host": "zoom.us",
            "path": [{ "type": "literal", "value": "join" }],
            "query": [
              { "name": "confno", "value": { "type": "capture", "name": "meeting" } },
              { "name": "pwd", "value": { "type": "capture", "name": "password" } }
            ]
          }
        },
        {
          "id": "join",
          "source": {
            "hosts": ["zoom.us", "us02web.zoom.us", "us04web.zoom.us", "us05web.zoom.us", "us06web.zoom.us", "us.web.zoom.us"],
            "path": [
              { "type": "literal", "value": "j" },
              { "type": "capture", "name": "meeting", "characterSet": "digits", "maxLength": 16 }
            ],
            "query": []
          },
          "target": {
            "scheme": "zoommtg",
            "host": "zoom.us",
            "path": [{ "type": "literal", "value": "join" }],
            "query": [
              { "name": "confno", "value": { "type": "capture", "name": "meeting" } }
            ]
          }
        }
      ]
    }
  ]
